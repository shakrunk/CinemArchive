<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: lets the updater reach a local test feed over plain HTTP through
     `adb reverse` (see UPDATE_FEED_URL in app/build.gradle.kts). Everything else keeps the
     platform default, which forbids cleartext. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
