<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR sign-in pane's live camera preview/scanner (feature/auth's LoginScreen). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- "How was it?" notification at the moment a cinema outing ends (Phase 5,
         docs/superpowers/plans/2026-07-21-android-cinema-outings.md §6) — degrades to
         foreground-only reconciliation if the user denies either. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Sideloaded installs update themselves from a GitHub Release APK (#146). Runtime-gated
         behind Settings.canRequestPackageInstalls(); when it isn't granted the update flow
         deep-links to the release page instead of failing. Only ever exercised for non-Play
         installs, so it carries no Play policy implication. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- enableOnBackInvokedCallback opts into the predictive back APIs, so the system runs
         its back animation and MainActivity's PredictiveBackHandler can drive the overlay's
         exit off the gesture's progress. Defaulted on when targeting SDK 36, but declared
         explicitly so the behaviour doesn't hinge on the target level. -->
    <application
        android:name=".CinemArchiveApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.CinemArchive.Splash">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Magic-link sign-in callback (AuthRepository.completeMagicLinkCallback) — must
                 match the redirect_to this app sends GoTrue, and that URL must be present in
                 the Supabase project's Auth > URL Configuration redirect allowlist. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cinemarchive" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".OutingCompletionReceiver"
            android:exported="false" />

        <!-- PackageInstaller's reply to a committed update session. Not optional: the system
             delivers its install-confirmation Intent here and installs nothing until the app
             launches it, so without this receiver the Install button silently does nothing.
             Not exported — the broadcast originates from this app's own PendingIntent. -->
        <receiver
            android:name=".InstallStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="work.kumarfamilynet.cinemarchive.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
